[Unit]
Description=cairn ZIM archive server (user)
Documentation=man:cairnd(8) man:cairn-api(7) man:cairn.conf(5)

[Service]
Type=exec
ExecStart=@BINDIR@/cairnd -c %h/.config/cairn/cairn.conf
ExecStartPre=@BINDIR@/cairnd -c %h/.config/cairn/cairn.conf --check
Restart=on-failure
RestartSec=1s
RuntimeDirectory=cairn
RuntimeDirectoryMode=0700
UMask=0077

# A user unit cannot assume PrivateNetwork or ProtectSystem are available,
# so it leans on what cairnd applies to itself. Set `sandbox = require` in
# the configuration to make that dependence explicit.
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
